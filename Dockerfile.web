FROM golang:1.26.8-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /ddz ./cmd/web
FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /ddz /usr/local/bin/ddz
USER 65532:65532
ENV WEB_ADDR=0.0.0.0:9017
EXPOSE 9017
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q -O /dev/null http://127.0.0.1:9017/health || exit 1
CMD ["ddz"]
